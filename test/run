#!/usr/bin/env bash
set -e -o pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

export GIT_AUTHOR_NAME=test GIT_AUTHOR_EMAIL=test@test
export GIT_COMMITTER_NAME=test GIT_COMMITTER_EMAIL=test@test
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null

MEGAMERGE_LIB=1 . "$ROOT/gh-megamerge"

pass=0 fail=0
ok() { pass=$((pass + 1)); echo "ok   $1"; }
bad() { fail=$((fail + 1)); echo "FAIL $1"; }
check() {
  if [ "$2" = "$3" ]; then ok "$1"; else bad "$1: want '$3', got '$2'"; fi
}

cd "$TMP"
git init -q repo
cd repo
echo one >a.txt
echo shared >s.txt
git add .
git commit -qm base
BASE_SHA=$(git rev-parse HEAD)

branch() {
  git checkout -q -b "$1" "${4:-$BASE_SHA}"
  echo "$3" >"$2"
  git add .
  git commit -qm "$1"
  git rev-parse HEAD
}

B1=$(branch b1 f1.txt one)
B2=$(branch b2 f2.txt two)
B3=$(branch b3 f3.txt three "$B1")
C1=$(branch c1 s.txt alpha)
C2=$(branch c2 s.txt beta)

final=$(compose_sources "$BASE_SHA" "b1=$B1" "b2=$B2")
check "compose merges two independent sources" \
  "$(git ls-tree --name-only "$final" | tr '\n' ' ')" \
  "a.txt f1.txt f2.txt s.txt "
check "compose parents are base plus both tips" \
  "$(git rev-list --parents -n1 "$final" | cut -d' ' -f2-)" \
  "$BASE_SHA $B1 $B2"
check "compose commit message names the sources" \
  "$(git log -1 --format=%s "$final")" \
  "megamerge: base + b1, b2"

again=$(compose_sources "$BASE_SHA" "b1=$B1" "b2=$B2")
check "compose is deterministic on the tree" \
  "$(git rev-parse "$again^{tree}")" "$(git rev-parse "$final^{tree}")"

stacked=$(compose_sources "$BASE_SHA" "b3=$B3" "b2=$B2")
check "a stacked tip brings its parent's changes" \
  "$(git ls-tree --name-only "$stacked" | tr '\n' ' ')" \
  "a.txt f1.txt f2.txt f3.txt s.txt "

if out=$(compose_sources "$BASE_SHA" "c1=$C1" "c2=$C2" 2>&1 >/dev/null); then
  bad "conflicting sources are refused"
else
  ok "conflicting sources are refused"
  case $out in
    *"conflict merging c2"*s.txt*) ok "conflict report names the source and file" ;;
    *) bad "conflict report names the source and file: got '$out'" ;;
  esac
fi

empty=$(compose_sources "$BASE_SHA")
check "no sources composes to the base tree" \
  "$(git rev-parse "$empty^{tree}")" "$(git rev-parse "$BASE_SHA^{tree}")"
check "no sources still commits on top of base" \
  "$(git rev-list --parents -n1 "$empty" | cut -d' ' -f2-)" "$BASE_SHA"

lines=$(printf 'b1\t%s\t10\tmain\nb3\t%s\t11\tb1\n' "$B1" "$B3")
check "filter drops a source contained in another" \
  "$(filter_sources "$BASE_SHA" "$lines" 2>/dev/null | cut -f1 | tr '\n' ' ')" \
  "b3 "

lines=$(printf 'noop\t%s\t12\tmain\n' "$BASE_SHA")
check "filter drops a source already in base" \
  "$(filter_sources "$BASE_SHA" "$lines" 2>/dev/null)" ""

lines=$(printf 'b1\t%s\t10\tmain\nb2\t%s\t13\tmain\n' "$B1" "$B2")
check "filter keeps independent sources" \
  "$(filter_sources "$BASE_SHA" "$lines" 2>/dev/null | cut -f1 | tr '\n' ' ')" \
  "b1 b2 "

BASE=main
git update-ref refs/remotes/origin/b1 "$B1"
lines=$(printf 'b1\t%s\t10\tmain\nb3\t%s\t11\tb1\n' "$B1" "$B3")
if (check_stacks "$lines") 2>/dev/null; then
  ok "a fresh stack passes the stale check"
else
  bad "a fresh stack passes the stale check"
fi

B1R=$(branch b1r f1.txt one-reworked)
git update-ref refs/remotes/origin/b1 "$B1R"
if out=$( (check_stacks "$lines") 2>&1); then
  bad "a reworked parent fails the stale check"
else
  case $out in
    *"stale stack: b3"*) ok "a reworked parent fails the stale check" ;;
    *) bad "a reworked parent fails the stale check: got '$out'" ;;
  esac
fi

BODY="above the block
$MARKER_START
### Sources

- \`carldaws/one\` (#101)
- \`carldaws/two\` (#102)

### Merged

- \`carldaws/done\` (#90)

Do not merge this PR or commit to its branch.
$MARKER_END
below the block"
check "sources parse out of the body block" \
  "$(sources_from_body | tr '\n' ' ')" \
  "carldaws/one carldaws/two "
check "merged entries stay out of the source list" \
  "$(merged_lines_from_body)" '- `carldaws/done` (#90)'

SLUG=demo
block=$(render_block '- `carldaws/done` (#90)' "carldaws/three=103")
expected="above the block
$block
below the block"
got=$(printf '%s\n' "$BODY" | MEGAMERGE_BLOCK="$block" awk -v s="$MARKER_START" -v e="$MARKER_END" '
  $0==s {print ENVIRON["MEGAMERGE_BLOCK"]; skip=1; next}
  $0==e {skip=0; next}
  skip!=1 {print}
')
check "block rewrite preserves surrounding body text" "$got" "$expected"
BODY=$got
check "rewritten block lists the new source" \
  "$(sources_from_body | tr '\n' ' ')" "carldaws/three "
check "rewritten block keeps the merged section" \
  "$(merged_lines_from_body)" '- `carldaws/done` (#90)'
case $(current_block) in
  *"Do not merge this PR or commit to its branch"*"Generated with [megamerge]"*) ok "trailer warns first, then links the tool" ;;
  *) bad "trailer warns first, then links the tool" ;;
esac

echo
echo "$pass passed, $fail failed"
[ "$fail" -eq 0 ]
